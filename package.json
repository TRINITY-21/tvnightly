{
  "name": "tvnightly",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run css && wrangler dev",
    "deploy": "npm run css && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "css": "node scripts/build-css.mjs",
    "css:watch": "node scripts/build-css.mjs --watch",
    "db:schema:local": "wrangler d1 execute tvnightly --local --file=migrations/0001_init.sql",
    "db:schema:remote": "wrangler d1 execute tvnightly --remote --file=migrations/0001_init.sql",
    "seed:fetch": "node scripts/seed.mjs",
    "seed:load:local": "wrangler d1 execute tvnightly --local --file=seed/seed.sql",
    "seed:load:remote": "wrangler d1 execute tvnightly --remote --file=seed/seed.sql",
    "blurbs:load:local": "wrangler d1 execute tvnightly --local --file=scripts/blurbs.sql",
    "cast:backfill:local": "node scripts/backfill-cast.mjs",
    "cast:backfill:remote": "REMOTE=1 node scripts/backfill-cast.mjs",
    "posters:backfill:local": "node scripts/backfill-posters.mjs",
    "posters:backfill:remote": "REMOTE=1 node scripts/backfill-posters.mjs",
    "people:enrich:local": "node scripts/backfill-people-tmdb.mjs",
    "people:enrich:remote": "REMOTE=1 node scripts/backfill-people-tmdb.mjs",
    "credits:tmdb:local": "node scripts/backfill-credits-tmdb.mjs",
    "credits:tmdb:remote": "REMOTE=1 node scripts/backfill-credits-tmdb.mjs",
    "blurbs:load:remote": "wrangler d1 execute tvnightly --remote --file=scripts/blurbs.sql",
    "movies:fetch": "node scripts/seed-movies.mjs",
    "movies:load:local": "wrangler d1 execute tvnightly --local --file=seed/movies.sql",
    "movies:load:remote": "wrangler d1 execute tvnightly --remote --file=seed/movies.sql",
    "providers:tv:fetch": "node scripts/seed-show-providers.mjs",
    "providers:tv:load:local": "wrangler d1 execute tvnightly --local --file=seed/show-providers.sql",
    "providers:tv:load:remote": "wrangler d1 execute tvnightly --remote --file=seed/show-providers.sql"
  },
  "dependencies": {
    "hono": "^4",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "typescript": "^5",
    "wrangler": "^4"
  }
}
