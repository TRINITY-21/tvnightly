{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tvnightly",
  "main": "src/index.tsx",
  "compatibility_date": "2026-04-01",
  // nodejs_compat enables TCP sockets for SMTP (worker-mailer / Gmail sending)
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  // Three crons, each with its own 50-subrequest budget:
  //   :00 hourly — TVmaze sync (shows/episodes/events/alerts + outbox drain)
  //   :30 hourly — provider patrol (availability diffing -> /whats-new)
  //   22:00 UTC daily — the TV Nightly digest (queued via outbox)
  "triggers": { "crons": ["0 * * * *", "30 * * * *", "0 22 * * *"] },
  "vars": {
    "SITE_ORIGIN": "https://tvnightly.com",
    // 'console' | 'gmail' | 'resend' — see src/email.ts
    "EMAIL_PROVIDER": "console",
    "EMAIL_FROM": "TV Nightly <alerts@tvnightly.com>"
  },
  // Secrets (set with `wrangler secret put NAME`, or .dev.vars locally):
  //   SECRET             — HMAC key for confirm/unsubscribe links (required in prod)
  //   GMAIL_USER         — your Gmail address          (EMAIL_PROVIDER=gmail)
  //   GMAIL_APP_PASSWORD — 16-char Google app password (EMAIL_PROVIDER=gmail)
  //   RESEND_API_KEY     — Resend key                  (EMAIL_PROVIDER=resend)
  //   TMDB_API_KEY       — provider patrol (streaming availability diffing)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tvnightly",
      // Local dev works with this placeholder. Before first deploy run
      // `wrangler d1 create tvnightly` and paste the real id here.
      "database_id": "REPLACE_AFTER_wrangler_d1_create"
    }
  ]
}
