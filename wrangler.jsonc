{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tvnightly",
  "main": "src/index.tsx",
  "compatibility_date": "2026-04-01",
  // nodejs_compat enables TCP sockets for SMTP (worker-mailer / Gmail sending)
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs + Traces. Sample everything at launch; lower head_sampling_rate
  // once traffic grows. Makes the console.* logging in index.tsx/sync.ts queryable.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // `binding: ASSETS` exposes the static dir to the Worker as a Fetcher (not just
  // public serving) so the card renderers can inline the brand fonts (src/lib/render.ts,
  // signal.ts). Without it c.env.ASSETS is undefined and resvg renders no text.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Three crons, each with its own 50-subrequest budget:
  //   :00 hourly — TVmaze sync (shows/episodes/events/alerts + outbox drain)
  //   :30 hourly — provider patrol (availability diffing -> /whats-new)
  //   22:00 UTC daily — the TV Nightly digest (queued via outbox)
  "triggers": { "crons": ["0 * * * *", "30 * * * *", "0 22 * * *"] },
  "vars": {
    "SITE_ORIGIN": "https://tvnightly.com",
    // 'console' | 'gmail' | 'smtp' | 'resend' — see src/email.ts. 'resend' sends
    // from EMAIL_FROM (your domain, DKIM-aligned) — needs the RESEND_API_KEY secret
    // and tvnightly.com verified in Resend. Until both are set, sends fail (logged)
    // but nothing else breaks. ('gmail' rewrote From to the Gmail account + capped
    // ~500/day — that's why we moved off it.)
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "TV Nightly <alerts@tvnightly.com>",
    // Reply-To on outbound mail → the monitored public inbox (Email Routing forwards
    // it to the team), so subscriber replies reach a human, not the alerts sender.
    "EMAIL_REPLY_TO": "contact@tvnightly.com",
    // /feedback notifications land here (contact@ forwards to the team inbox)
    "FEEDBACK_TO": "contact@tvnightly.com"
    // CF_BEACON_TOKEN — paste here (it's public, not a secret) AFTER creating the
    // Cloudflare Web Analytics site post-deploy; the beacon renders only when set.
    // TURNSTILE_SITE_KEY — paste the Turnstile widget sitekey (public) after
    // creating the widget; /feedback renders the anti-spam widget only when set.
  },
  // Secrets (set with `wrangler secret put NAME`, or .dev.vars locally):
  //   SECRET         — HMAC key for confirm/unsubscribe links (required in prod)
  //   SMTP_USER      — SMTP / Gmail address              (EMAIL_PROVIDER=gmail|smtp)
  //   SMTP_PASS      — SMTP password / Gmail app password (EMAIL_PROVIDER=gmail|smtp)
  //   SMTP_HOST/SMTP_PORT — optional; default smtp.gmail.com:465
  //   RESEND_API_KEY — Resend key                        (EMAIL_PROVIDER=resend)
  //   TMDB_API_KEY   — provider patrol (streaming availability diffing)
  //   TURNSTILE_SECRET_KEY — Turnstile secret (siteverify for /feedback anti-spam)
  //   ADMIN_KEY      — basic-auth password for /admin/* (unset = admin disabled)
  //   FEEDBACK_TO    — where /feedback emails go (optional; falls back to EMAIL_FROM)
  // Migrations are tracked natively: `npm run db:migrate:remote` (and :local).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tvnightly",
      // migrations live in ./migrations, applied in order with run-once tracking.
      "migrations_dir": "migrations",
      "database_id": "7fb8c3fa-99f4-4df1-9ccb-ab10ea0df88e"
    }
  ],
  // Workers Rate Limiting (account-local, best-effort, per-colo). Throttles the
  // unauthenticated /feedback write+email (5/min/IP) and failed /admin auth
  // (10/min/IP), so neither can flood the inbox/mailbox or brute-force ADMIN_KEY.
  // period must be 10 or 60; namespace_id is any unique-per-worker integer.
  "unsafe": {
    "bindings": [
      { "name": "FEEDBACK_LIMIT", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
      { "name": "ADMIN_LIMIT", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
    ]
  }
}
