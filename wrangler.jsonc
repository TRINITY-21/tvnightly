{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tvnightly",
  "compatibility_date": "2026-04-01",
  // ── ARCHIVED (2026-09-07) ─────────────────────────────────────────────────
  // TV Nightly is parked. This is now an assets-only Worker: no `main`, so no
  // script runs and no CPU is billed; no crons; no D1 / rate-limit bindings.
  // The site is the single static page in ./parked (index.html + 404.html).
  // The full app (src/, migrations/, the old wrangler config) stays in git
  // history — see commit "Archive TV Nightly" for the pre-archive config.
  "assets": {
    "directory": "./parked",
    // Every former URL (/tv/…, /movies/…, /sitemap.xml, …) returns the parked
    // page with a real 404 status so search engines drop the old catalog.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "tvnightly.com", "custom_domain": true },
    { "pattern": "www.tvnightly.com", "custom_domain": true }
  ],
  // Explicit empty list so `wrangler deploy` clears the four old cron triggers
  // (hourly outbox drain, daily TVmaze sync, provider patrol, digest).
  "triggers": { "crons": [] }
}
